# For dotnet run against a local Windows default instance, use:
# ConnectionStrings__Default=Server=localhost;Database=FlatDuty;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
# For a container, use a reachable SQL host and a SQL login.
ConnectionStrings__Default=Server=YOUR_SQL_HOST;Database=FlatDuty;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False
BotToken=YOUR_BOT_TOKEN
Cutoff=08:00
Schedule__CollectionDays=Thursday,Sunday
Schedule__AssignmentTime=21:00
Schedule__ReminderStart=06:30
Schedule__BackupTime=07:00
Schedule__IntervalMinutes=5
# Replace these six names. Leave new ChatId values at 0 and use --invites to enroll.
Members__0__Name=Flatmate 1
Members__0__ChatId=0
Members__1__Name=Flatmate 2
Members__1__ChatId=0
Members__2__Name=Flatmate 3
Members__2__ChatId=0
Members__3__Name=Flatmate 4
Members__3__ChatId=0
Members__4__Name=Flatmate 5
Members__4__ChatId=0
Members__5__Name=Flatmate 6
Members__5__ChatId=0
